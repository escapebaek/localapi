# 복사해서 .env 로 저장 후 수정하세요. (setup 스크립트가 자동 생성)

# ---- 게이트웨이 ----
# 127.0.0.1 = 이 노트북에서만 접근. 다른 기기에서 부르려면 Tailscale IP 또는 0.0.0.0
HOST=127.0.0.1
PORT=8000
# 쉼표로 여러 개 가능. 클라이언트는 "Authorization: Bearer <키>" 또는 "X-API-Key: <키>" 로 전송
API_KEYS=change-me
# 브라우저(웹사이트)에서 직접 호출할 때만 설정. 예: https://my-site.example,http://localhost:3000
CORS_ORIGINS=

# ---- 모델 ----
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen3.5:4b
# 요청에서 고를 수 있는 모델 목록 (비우면 DEFAULT_MODEL만 허용). 클라우드 모델 차단 역할도 함
ALLOWED_MODELS=qwen3.5:4b,qwen3.5:2b
# Qwen의 thinking(추론) 모드. false 권장 (켜면 2~5배 느려짐). 요청마다 "think": true 로 켤 수 있음
DEFAULT_THINK=false
# 컨텍스트 길이(토큰). 늘릴수록 VRAM/RAM 사용 증가
NUM_CTX=4096
# GPU에 올릴 레이어 수. 비우면 Ollama가 자동 결정. 0 = CPU 전용
# ("CUDA error: ... unsupported toolchain" 처럼 GPU 오류가 나고 드라이버 업데이트로도 안 될 때)
NUM_GPU=
KEEP_ALIVE=30m

# ---- 제한 ----
MAX_CONCURRENT=1
REQUEST_TIMEOUT=600
MAX_INPUT_CHARS=32000
MAX_OUTPUT_TOKENS=4096
JOB_TTL=3600
MAX_JOBS=100
